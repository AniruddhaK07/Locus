# Locus Environment Configuration Example

# Optional contact info for Nominatim identification:
# In direct-from-browser mode, requests are client-side. If provided, this is passed
# as the &email= query parameter on on-submit city resolution. If omitted,
# Nominatim identifies the application via the browser's Referer origin.
GEO_CONTACT=your_contact_email@example.com

# Engine mode: "mock" (default, runs without network using deterministic fixtures) or "live"
VITE_ENGINE_MODE=mock
